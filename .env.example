SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mistral AI (chosen provider) goes through the OpenAI-compatible adapter.
LLM_PROVIDER=openai_compatible    # anthropic | openai_compatible | mock (local/load test only)
LLM_API_KEY=                      # Mistral API key (console.mistral.ai)
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_JSON_MODE=true                # sends response_format {"type":"json_object"}
LLM_MODEL_GRADER=                 # exact dated model id, pinned for the whole study (npm run llm:models)
LLM_MODEL_TUTOR=                  # exact dated model id, pinned for the whole study

STUDY_TOKEN=                      # random 10+ characters; the study lives at /q/{STUDY_TOKEN}
STUDY_OPEN_FROM=                  # ISO datetime
STUDY_OPEN_UNTIL=                 # ISO datetime
COOKIE_SECRET=                    # 32+ random bytes (e.g. openssl rand -hex 32)

RANDOM_SHARE=0.5
N_QUESTIONS=12
RATING_SAMPLE_P=0.25
PROMPT_VERSION=v1
APP_VERSION=                      # leave empty on Vercel: VERCEL_GIT_COMMIT_SHA is used
